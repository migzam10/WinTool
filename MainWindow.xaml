<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WinTool - Windows Optimization &amp; Maintenance Toolkit"
        Height="820" Width="920"
        MinHeight="720" MinWidth="850"
        WindowStartupLocation="CenterScreen"
        Background="#080A10"
        FontFamily="Segoe UI">

  <Window.Resources>
    <!-- Base Tool Button Style -->
    <Style x:Key="ToolButton" TargetType="Button">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="border"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="10">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="border" Property="Opacity" Value="0.85"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="border" Property="Opacity" Value="0.65"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Action Pill Button -->
    <Style x:Key="ActionPillButton" TargetType="Button">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Foreground" Value="#FFFFFF"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Padding" Value="14,8"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="border"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="border" Property="Opacity" Value="0.85"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="border" Property="Opacity" Value="0.65"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Dark Tab Item Style -->
    <Style x:Key="ModernTabItem" TargetType="TabItem">
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="#94A3B8"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Padding" Value="16,8"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TabItem">
            <Border x:Name="tabBorder"
                    Background="{TemplateBinding Background}"
                    BorderThickness="0,0,0,2"
                    BorderBrush="Transparent"
                    Padding="{TemplateBinding Padding}"
                    Margin="0,0,8,0">
              <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="tabBorder" Property="Background" Value="#111827"/>
                <Setter Property="Foreground" Value="#E2E8F0"/>
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="tabBorder" Property="BorderBrush" Value="#3B82F6"/>
                <Setter TargetName="tabBorder" Property="Background" Value="#131D31"/>
                <Setter Property="Foreground" Value="#60A5FA"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Clean Checkbox Style -->
    <Style x:Key="CleanCheckBox" TargetType="CheckBox">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Foreground" Value="#E2E8F0"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
  </Window.Resources>

  <Grid Margin="24,18,24,16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>  <!-- Header & Title -->
      <RowDefinition Height="Auto"/>  <!-- SysInfo Dashboard Card -->
      <RowDefinition Height="*"/>     <!-- Tabs & Content -->
      <RowDefinition Height="Auto"/>  <!-- Console Log Panel -->
      <RowDefinition Height="Auto"/>  <!-- Footer -->
    </Grid.RowDefinitions>

    <!-- ── HEADER ────────────────────────────────────────────────── -->
    <Grid Grid.Row="0" Margin="0,0,0,12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <StackPanel Grid.Column="0">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Border Background="#1D4ED8" CornerRadius="6" Width="26" Height="26" Margin="0,0,10,0">
            <Path Data="M4,4 H20 A2,2 0 0 1 22,6 V18 A2,2 0 0 1 20,20 H4 A2,2 0 0 1 2,18 V6 A2,2 0 0 1 4,4 Z M5,14 A1.5,1.5 0 1 0 5,17 A1.5,1.5 0 0 0 5,14 M19,15.5 H12"
                  Fill="#FFFFFF" Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <TextBlock Text="WinTool" FontSize="22" FontWeight="Bold" Foreground="#F8FAFC"/>
          <Border Background="#1E293B" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
            <TextBlock Text="PRO v1.1" FontSize="10" FontWeight="Bold" Foreground="#38BDF8"/>
          </Border>
        </StackPanel>
        <TextBlock Text="Optimización, Limpieza y Mantenimiento Avanzado de Windows"
                   FontSize="12" Foreground="#64748B" Margin="36,2,0,0"/>
      </StackPanel>

      <!-- Refresh SysInfo Button -->
      <Button Name="btnRefreshSysInfo" Grid.Column="1"
              Style="{StaticResource ActionPillButton}"
              Background="#0F172A" BorderBrush="#334155"
              ToolTip="Recargar información del sistema" VerticalAlignment="Center">
        <StackPanel Orientation="Horizontal">
          <Path Data="M17.65,6.35 C16.2,4.9 14.21,4 12,4 C7.58,4 4.01,7.58 4.01,12 C4.01,16.42 7.58,20 12,20 C15.73,20 18.84,17.45 19.73,14 L17.65,14 C16.83,16.33 14.61,18 12,18 C8.69,18 6,15.31 6,12 C6,8.69 8.69,6 12,6 C13.66,6 15.14,6.69 16.22,7.78 L13,11 L20,11 L20,4 L17.65,6.35 Z"
                Fill="#94A3B8" Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,6,0"/>
          <TextBlock Text="Actualizar Info" FontSize="11" Foreground="#94A3B8"/>
        </StackPanel>
      </Button>
    </Grid>

    <!-- ── MINI-DASHBOARD (SYSINFO) ──────────────────────────────── -->
    <Border Grid.Row="1" Background="#0D111A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="0,0,0,14">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="1"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="1"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="1"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- OS -->
        <StackPanel Grid.Column="0" Margin="6,0">
          <TextBlock Text="SISTEMA OPERATIVO" FontSize="10" FontWeight="Bold" Foreground="#64748B"/>
          <TextBlock Name="txtSysOS" Text="Detectando Windows..." FontSize="12" FontWeight="SemiBold" Foreground="#E2E8F0" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
        </StackPanel>
        <Rectangle Grid.Column="1" Fill="#1E293B"/>

        <!-- CPU -->
        <StackPanel Grid.Column="2" Margin="10,0,6,0">
          <TextBlock Text="PROCESADOR" FontSize="10" FontWeight="Bold" Foreground="#64748B"/>
          <TextBlock Name="txtSysCPU" Text="Detectando CPU..." FontSize="12" FontWeight="SemiBold" Foreground="#93C5FD" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
        </StackPanel>
        <Rectangle Grid.Column="3" Fill="#1E293B"/>

        <!-- RAM -->
        <StackPanel Grid.Column="4" Margin="10,0,6,0">
          <TextBlock Text="MEMORIA RAM" FontSize="10" FontWeight="Bold" Foreground="#64748B"/>
          <TextBlock Name="txtSysRAM" Text="Calculando..." FontSize="12" FontWeight="SemiBold" Foreground="#A7F3D0" Margin="0,3,0,0"/>
        </StackPanel>
        <Rectangle Grid.Column="5" Fill="#1E293B"/>

        <!-- Disk C: -->
        <StackPanel Grid.Column="6" Margin="10,0,6,0">
          <TextBlock Text="UNIDAD C:" FontSize="10" FontWeight="Bold" Foreground="#64748B"/>
          <TextBlock Name="txtSysDisk" Text="Calculando espacio..." FontSize="12" FontWeight="SemiBold" Foreground="#FDE047" Margin="0,3,0,0"/>
        </StackPanel>
      </Grid>
    </Border>

    <!-- ── TABS AND TOOLS ────────────────────────────────────────── -->
    <TabControl Grid.Row="2" Background="Transparent" BorderThickness="0" Margin="0,0,0,12">

      <!-- ── TAB 1: MANTENIMIENTO ──────────────────────────────────── -->
      <TabItem Header="🛠️ Mantenimiento" Style="{StaticResource ModernTabItem}">
        <Grid Margin="0,14,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="14"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>

          <!-- Optimize Drive -->
          <Button Name="btnOptimizeDrive" Grid.Row="0" Grid.Column="0"
                  Style="{StaticResource ToolButton}"
                  Background="#0F172A" BorderBrush="#2563EB" Height="80">
            <Grid Margin="16,0" VerticalAlignment="Center">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="42"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Border Grid.Column="0" Background="#1E3A8A" CornerRadius="8" Width="36" Height="36" HorizontalAlignment="Left">
                <Path Data="M4,4 H20 A2,2 0 0 1 22,6 V18 A2,2 0 0 1 20,20 H4 A2,2 0 0 1 2,18 V6 A2,2 0 0 1 4,4 Z M5,14 A1.5,1.5 0 1 0 5,17 A1.5,1.5 0 0 0 5,14 M19,15.5 H12"
                      Fill="#93C5FD" Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="Optimizar Unidad C:" FontSize="15" FontWeight="SemiBold" Foreground="#93C5FD"/>
                <TextBlock Text="TRIM automático en SSD / Defragmentación en HDD" FontSize="11" Foreground="#94A3B8" Margin="0,3,0,0"/>
              </StackPanel>
            </Grid>
          </Button>

          <!-- SFC Scannow -->
          <Button Name="btnSFC" Grid.Row="0" Grid.Column="2"
                  Style="{StaticResource ToolButton}"
                  Background="#150F2D" BorderBrush="#7C3AED" Height="80">
            <Grid Margin="16,0" VerticalAlignment="Center">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="42"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Border Grid.Column="0" Background="#3B0764" CornerRadius="8" Width="36" Height="36" HorizontalAlignment="Left">
                <Path Data="M15.5,14 H14.71 L14.43,13.73 A6.5,6.5 0 1 0 13.73,14.43 L14,14.71 V15.5 L19,20.49 L20.49,19 L15.5,14 Z M9.5,14 A4.5,4.5 0 1 1 14,9.5 A4.5,4.5 0 0 1 9.5,14 Z"
                      Fill="#C4B5FD" Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="SFC Scannow" FontSize="15" FontWeight="SemiBold" Foreground="#C4B5FD"/>
                <TextBlock Text="Escanear y reparar archivos dañados del sistema" FontSize="11" Foreground="#94A3B8" Margin="0,3,0,0"/>
              </StackPanel>
            </Grid>
          </Button>

          <!-- DISM RestoreHealth -->
          <Button Name="btnDISM" Grid.Row="2" Grid.Column="0"
                  Style="{StaticResource ToolButton}"
                  Background="#0F2318" BorderBrush="#16A34A" Height="80">
            <Grid Margin="16,0" VerticalAlignment="Center">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="42"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Border Grid.Column="0" Background="#064E3B" CornerRadius="8" Width="36" Height="36" HorizontalAlignment="Left">
                <Path Data="M22.7,19 L13.68,9.98 A5.99,5.99 0 0 0 14,7 A6,6 0 0 0 8,1 A5.98,5.98 0 0 0 2.25,5.22 L5.66,8.63 L4.25,10.04 L0.84,6.63 A5.98,5.98 0 0 0 5,14 A6,6 0 0 0 8,13.68 L17.02,22.7 A1.5,1.5 0 0 0 19.14,22.7 L22.7,19.14 A1.5,1.5 0 0 0 22.7,19 Z"
                      Fill="#86EFAC" Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="DISM RestoreHealth" FontSize="15" FontWeight="SemiBold" Foreground="#86EFAC"/>
                <TextBlock Text="Reparar imagen del almacén de componentes de Windows" FontSize="11" Foreground="#94A3B8" Margin="0,3,0,0"/>
              </StackPanel>
            </Grid>
          </Button>

          <!-- Reparar Windows Update -->
          <Button Name="btnRepairWU" Grid.Row="2" Grid.Column="2"
                  Style="{StaticResource ToolButton}"
                  Background="#1A1505" BorderBrush="#D97706" Height="80">
            <Grid Margin="16,0" VerticalAlignment="Center">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="42"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Border Grid.Column="0" Background="#78350F" CornerRadius="8" Width="36" Height="36" HorizontalAlignment="Left">
                <Path Data="M12,4 V1 L8,5 L12,9 V6 C15.31,6 18,8.69 18,12 C18,13.01 17.75,13.97 17.3,14.8 L18.76,16.26 C19.54,15.03 20,13.57 20,12 C20,7.58 16.42,4 12,4 Z M12,18 C8.69,18 6,15.31 6,12 C6,10.99 6.25,10.03 6.7,9.2 L5.24,7.74 C4.46,8.97 4,10.43 4,12 C4,16.42 7.58,20 12,20 V23 L16,19 L12,15 V18 Z"
                      Fill="#FDE047" Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="Reparar Windows Update" FontSize="15" FontWeight="SemiBold" Foreground="#FDE047"/>
                <TextBlock Text="Restablecer servicios, SoftwareDistribution y catroot2" FontSize="11" Foreground="#94A3B8" Margin="0,3,0,0"/>
              </StackPanel>
            </Grid>
          </Button>

          <!-- Punto de Restauración -->
          <Button Name="btnCreateRestorePoint" Grid.Row="4" Grid.Column="0"
                  Style="{StaticResource ToolButton}"
                  Background="#091E24" BorderBrush="#0891B2" Height="80">
            <Grid Margin="16,0" VerticalAlignment="Center">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="42"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Border Grid.Column="0" Background="#164E63" CornerRadius="8" Width="36" Height="36" HorizontalAlignment="Left">
                <Path Data="M12,1 L3,5 V11 C3,16.55 6.84,21.74 12,23 C17.16,21.74 21,16.55 21,11 V5 L12,1 Z M12,11.99 H19 C18.47,15.7 15.68,18.89 12,19.93 V12 L5,12 V6.3 L12,3.19 V11.99 Z"
                      Fill="#67E8F9" Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="Punto de Restauración" FontSize="15" FontWeight="SemiBold" Foreground="#67E8F9"/>
                <TextBlock Text="Crear respaldo del sistema antes de realizar cambios" FontSize="11" Foreground="#94A3B8" Margin="0,3,0,0"/>
              </StackPanel>
            </Grid>
          </Button>
        </Grid>
      </TabItem>

      <!-- ── TAB 2: LIMPIEZA DE SISTEMA (CON SELECCIÓN) ────────────── -->
      <TabItem Header="🧹 Limpieza de Sistema" Style="{StaticResource ModernTabItem}">
        <Grid Margin="0,14,0,0">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Action bar (Select all / Deselect) -->
            <RowDefinition Height="*"/>     <!-- Checkboxes Grid -->
            <RowDefinition Height="Auto"/>  <!-- Bottom Action Bar (Analyze & Clean) -->
          </Grid.RowDefinitions>

          <!-- Top Toolbar -->
          <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Selecciona los componentes que deseas analizar y limpiar:"
                       FontSize="13" Foreground="#94A3B8" VerticalAlignment="Center"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
              <Button Name="btnSelectAll" Content="Marcar todos"
                      Style="{StaticResource ActionPillButton}"
                      Background="#1E293B" BorderBrush="#334155" Margin="0,0,8,0" Padding="10,5" FontSize="11"/>
              <Button Name="btnDeselectAll" Content="Desmarcar todos"
                      Style="{StaticResource ActionPillButton}"
                      Background="#1E293B" BorderBrush="#334155" Padding="10,5" FontSize="11"/>
            </StackPanel>
          </Grid>

          <!-- Checkbox Cards List -->
          <Border Grid.Row="1" Background="#0C1019" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="10" Padding="14,10">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="8"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="8"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>

              <!-- 1. Temporales de Usuario -->
              <Border Grid.Row="0" Grid.Column="0" Background="#111827" BorderBrush="#1F2937" BorderThickness="1" CornerRadius="8" Padding="12,10">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <CheckBox Name="chkUserTemp" IsChecked="True" Style="{StaticResource CleanCheckBox}">
                    <StackPanel Margin="6,0,0,0">
                      <TextBlock Text="Temporales de Usuario (%TEMP%)" FontWeight="SemiBold" Foreground="#F1F5F9"/>
                      <TextBlock Text="Archivos temporales generados por programas de usuario" FontSize="11" Foreground="#64748B"/>
                    </StackPanel>
                  </CheckBox>
                  <Border Grid.Column="1" Background="#1E293B" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                    <TextBlock Name="lblSizeUserTemp" Text="--" FontSize="11" FontWeight="Bold" Foreground="#38BDF8"/>
                  </Border>
                </Grid>
              </Border>

              <!-- 2. Temporales de Windows -->
              <Border Grid.Row="0" Grid.Column="2" Background="#111827" BorderBrush="#1F2937" BorderThickness="1" CornerRadius="8" Padding="12,10">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <CheckBox Name="chkWinTemp" IsChecked="True" Style="{StaticResource CleanCheckBox}">
                    <StackPanel Margin="6,0,0,0">
                      <TextBlock Text="Temporales de Windows (C:\Windows\Temp)" FontWeight="SemiBold" Foreground="#F1F5F9"/>
                      <TextBlock Text="Archivos temporales del sistema y servicios" FontSize="11" Foreground="#64748B"/>
                    </StackPanel>
                  </CheckBox>
                  <Border Grid.Column="1" Background="#1E293B" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                    <TextBlock Name="lblSizeWinTemp" Text="--" FontSize="11" FontWeight="Bold" Foreground="#38BDF8"/>
                  </Border>
                </Grid>
              </Border>

              <!-- 3. Caché de Windows Update -->
              <Border Grid.Row="2" Grid.Column="0" Background="#111827" BorderBrush="#1F2937" BorderThickness="1" CornerRadius="8" Padding="12,10">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <CheckBox Name="chkUpdateCache" IsChecked="True" Style="{StaticResource CleanCheckBox}">
                    <StackPanel Margin="6,0,0,0">
                      <TextBlock Text="Caché de Windows Update" FontWeight="SemiBold" Foreground="#F1F5F9"/>
                      <TextBlock Text="Instaladores antiguos en SoftwareDistribution\Download" FontSize="11" Foreground="#64748B"/>
                    </StackPanel>
                  </CheckBox>
                  <Border Grid.Column="1" Background="#1E293B" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                    <TextBlock Name="lblSizeUpdateCache" Text="--" FontSize="11" FontWeight="Bold" Foreground="#38BDF8"/>
                  </Border>
                </Grid>
              </Border>

              <!-- 4. Papelera de Reciclaje -->
              <Border Grid.Row="2" Grid.Column="2" Background="#111827" BorderBrush="#1F2937" BorderThickness="1" CornerRadius="8" Padding="12,10">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <CheckBox Name="chkRecycleBin" IsChecked="True" Style="{StaticResource CleanCheckBox}">
                    <StackPanel Margin="6,0,0,0">
                      <TextBlock Text="Papelera de Reciclaje" FontWeight="SemiBold" Foreground="#F1F5F9"/>
                      <TextBlock Text="Vacía los archivos eliminados de todas las unidades" FontSize="11" Foreground="#64748B"/>
                    </StackPanel>
                  </CheckBox>
                  <Border Grid.Column="1" Background="#1E293B" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                    <TextBlock Name="lblSizeRecycleBin" Text="--" FontSize="11" FontWeight="Bold" Foreground="#38BDF8"/>
                  </Border>
                </Grid>
              </Border>

              <!-- 5. Miniaturas y reportes WER -->
              <Border Grid.Row="4" Grid.Column="0" Background="#111827" BorderBrush="#1F2937" BorderThickness="1" CornerRadius="8" Padding="12,10">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <CheckBox Name="chkThumbCache" IsChecked="True" Style="{StaticResource CleanCheckBox}">
                    <StackPanel Margin="6,0,0,0">
                      <TextBlock Text="Miniaturas y Reportes WER" FontWeight="SemiBold" Foreground="#F1F5F9"/>
                      <TextBlock Text="Caché de iconos/miniaturas y registros de error" FontSize="11" Foreground="#64748B"/>
                    </StackPanel>
                  </CheckBox>
                  <Border Grid.Column="1" Background="#1E293B" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                    <TextBlock Name="lblSizeThumbCache" Text="--" FontSize="11" FontWeight="Bold" Foreground="#38BDF8"/>
                  </Border>
                </Grid>
              </Border>

              <!-- 6. Caché DNS -->
              <Border Grid.Row="4" Grid.Column="2" Background="#111827" BorderBrush="#1F2937" BorderThickness="1" CornerRadius="8" Padding="12,10">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <CheckBox Name="chkDnsCache" IsChecked="False" Style="{StaticResource CleanCheckBox}">
                    <StackPanel Margin="6,0,0,0">
                      <TextBlock Text="Caché de Resolución DNS" FontWeight="SemiBold" Foreground="#F1F5F9"/>
                      <TextBlock Text="Borra tablas de dominios e IPs cacheadas" FontSize="11" Foreground="#64748B"/>
                    </StackPanel>
                  </CheckBox>
                  <Border Grid.Column="1" Background="#1E293B" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                    <TextBlock Name="lblSizeDnsCache" Text="--" FontSize="11" FontWeight="Bold" Foreground="#38BDF8"/>
                  </Border>
                </Grid>
              </Border>
            </Grid>
          </Border>

          <!-- Bottom Action Buttons & Summary -->
          <Border Grid.Row="2" Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,12,0,0">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0" VerticalAlignment="Center">
