<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WinTool" Height="760" Width="720"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        Background="#0B0D14"
        FontFamily="Segoe UI">

  <Window.Resources>

    <!-- Base Button Style -->
    <Style x:Key="ToolButton" TargetType="Button">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="border"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="10">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="border" Property="Opacity" Value="0.80"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="border" Property="Opacity" Value="0.60"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

  </Window.Resources>

  <Grid Margin="28,20,28,24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>  <!-- Header -->
      <RowDefinition Height="16"/>
      <RowDefinition Height="*"/>     <!-- Buttons -->
      <RowDefinition Height="16"/>
      <RowDefinition Height="Auto"/>  <!-- Footer -->
    </Grid.RowDefinitions>

    <!-- ── HEADER ────────────────────────────────────────────────── -->
    <StackPanel Grid.Row="0">
      <TextBlock Text="WinTool - MigZam"
                 FontSize="26" FontWeight="Bold"
                 Foreground="#E2E8F0"/>
      <TextBlock Text="Herramientas de mantenimiento y utilidades del sistema"
                 FontSize="12" Foreground="#64748B" Margin="0,2,0,0"/>
      <Rectangle Height="1" Fill="#1E2D40" Margin="0,12,0,0"/>
    </StackPanel>

    <!-- ── BUTTON GRID ────────────────────────────────────────────── -->
    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="14"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="*"/>
        <RowDefinition Height="14"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="14"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <!-- ── Optimize Drive ─────────────────────────────────────── -->
      <Button Name="btnOptimizeDrive"
              Grid.Row="0" Grid.Column="0"
              Style="{StaticResource ToolButton}"
              Background="#0F1B2D"
              BorderBrush="#1D4ED8">
        <StackPanel Orientation="Horizontal" Margin="18,16" VerticalAlignment="Center">

          <TextBlock Text="💽" FontSize="30" VerticalAlignment="Center"  Foreground="#fff"/>

          <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
          
          <TextBlock Text="Optimizar unidad" FontSize="18" FontWeight="SemiBold"
                     Foreground="#93C5FD" Margin="0,8,0,0"/>
          <TextBlock Text="Defrag en HDD / TRIM en SSD"
                     FontSize="11" Foreground="#fff" TextWrapping="Wrap" Margin="0,4,0,0"/>
                     </StackPanel>
        </StackPanel>
      </Button>

      <!-- ── SFC ────────────────────────────────────────────────── -->
      <Button Name="btnSFC"
              Grid.Row="0" Grid.Column="2"
              Style="{StaticResource ToolButton}"
              Background="#150F2D"
              BorderBrush="#7C3AED">
        <StackPanel Orientation="Horizontal" Margin="18,16" VerticalAlignment="Center">

          <TextBlock Text="🔍" FontSize="30" VerticalAlignment="Center"  Foreground="#fff"/>

          <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
            <TextBlock Text="SFC Scannow" FontSize="18" FontWeight="SemiBold"
                      Foreground="#C4B5FD" Margin="0,8,0,0"/>
            <TextBlock Text="Reparar archivos del sistema corruptos"
                      FontSize="11" Foreground="#fff" TextWrapping="Wrap" Margin="0,4,0,0"/>
          </StackPanel>
        </StackPanel>
      </Button>

      <!-- ── DISM ───────────────────────────────────────────────── -->
     <Button Name="btnDISM"
              Grid.Row="2" Grid.Column="0"
              Style="{StaticResource ToolButton}"
              Background="#0F2318"
              BorderBrush="#16A34A">
        <StackPanel Orientation="Horizontal" Margin="18,16" VerticalAlignment="Center">
          
          <TextBlock Text="🛠️" FontSize="30" VerticalAlignment="Center"  Foreground="#fff"/>
          
          <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
            <TextBlock Text="DISM RestoreHealth" FontSize="18" FontWeight="SemiBold"
                       Foreground="#86EFAC"/>
            <TextBlock Text="Check → Scan → Restore"
                       FontSize="11" Foreground="#fff" TextWrapping="Wrap" Margin="0,4,0,0"/>
          </StackPanel>
          
        </StackPanel>
      </Button>

      <!-- ── WlanProfiles ───────────────────────────────────────── -->
      <Button Name="btnWlanProfiles"
              Grid.Row="2" Grid.Column="2"
              Style="{StaticResource ToolButton}"
              Background="#1A1409"
              BorderBrush="#CA8A04">
        <StackPanel Orientation="Horizontal" Margin="18,16" VerticalAlignment="Center">
          
          <TextBlock Text="📡" FontSize="30" VerticalAlignment="Center"  Foreground="#fff"/>
          
          <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
          <TextBlock Text="Obtener WI-FI" FontSize="18" FontWeight="SemiBold"
                     Foreground="#FDE047" Margin="0,8,0,0"/>
          <TextBlock Text="Exportar y gestionar perfiles WiFi guardados"
                     FontSize="11" Foreground="#fff" TextWrapping="Wrap" Margin="0,4,0,0"/>
          </StackPanel>          
        </StackPanel>
      </Button>

      <!-- ── ChrisTitus WinUtil ─────────────────────────────────── -->
      <Button Name="btnWinUtil"
              Grid.Row="4" Grid.Column="0"
              Style="{StaticResource ToolButton}"
              Background="#1A0F0F"
              BorderBrush="#DC2626">
        <StackPanel Orientation="Horizontal" Margin="18,16" VerticalAlignment="Center">
          
          <TextBlock Text="🚀" FontSize="30" VerticalAlignment="Center"  Foreground="#fff"/>
          
          <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
         
            <TextBlock Text="Chris Titus WinUtil" FontSize="14" FontWeight="SemiBold"
                       Foreground="#FCA5A5"/>
            <TextBlock Text="Lanzar el utilitario de optimización de Windows de ChrisTitusTech"
                       FontSize="11" Foreground="#fff"/>
                       
          </StackPanel>
        </StackPanel>
      </Button>
      <!-- ── Activar Windows ─────────────────────────────────── -->
      <Button Name="btnActivarWin"
              Grid.Row="4" Grid.Column="2"
              Style="{StaticResource ToolButton}"
              Background="#0A1D1C"
              BorderBrush="#35cabe">
        <StackPanel Orientation="Horizontal" Margin="18,16" VerticalAlignment="Center">
          
          <TextBlock Text="✅" FontSize="30" VerticalAlignment="Center"  Foreground="#fff"/>
          
          <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
         
            <TextBlock Text="Activar Windows / Office" FontSize="14" FontWeight="SemiBold"
                       Foreground="#35cabe"/>
            <TextBlock Text="Lanzar el utilitario de Massgrave"
                       FontSize="11" Foreground="#fff"/>
                     
          </StackPanel>
        </StackPanel>
      </Button>

    </Grid>

    <!-- ── FOOTER ─────────────────────────────────────────────────── -->
    <StackPanel Grid.Row="4" Orientation="Horizontal">
      <TextBlock Text="github.com/migzam10/WinTool"
                 FontSize="10" Foreground="#9aa0aa" VerticalAlignment="Center"/>
      <TextBlock Text="  ·  v1.0" FontSize="10" Foreground="#244672" VerticalAlignment="Center"/>
    </StackPanel>

  </Grid>
</Window>