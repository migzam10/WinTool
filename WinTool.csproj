<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- .NET Framework 4.5 viene preinstalado de fábrica desde Windows 8 hasta Windows 11 -->
    <TargetFramework>net45</TargetFramework>
    <AssemblyName>WinTool</AssemblyName>
    <RootNamespace>WinTool</RootNamespace>
    <ApplicationManifest>src\app.manifest</ApplicationManifest>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="PresentationFramework" />
    <Reference Include="PresentationCore" />
    <Reference Include="WindowsBase" />
    <Reference Include="System.Xaml" />
    <Reference Include="System.Xml" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="src\Program.cs" />
    <EmbeddedResource Include="MainWindow.xaml" LogicalName="MainWindow.xaml" />
    <EmbeddedResource Include="scripts\maintenance.ps1" LogicalName="maintenance.ps1" />
  </ItemGroup>

</Project>
